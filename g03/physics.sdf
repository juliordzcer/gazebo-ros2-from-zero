          </material>
        </visual>
      </link>
      <joint name="weld" type="fixed">
        <parent>world</parent>
        <child>post</child>
      </joint>
      <joint name="hinge" type="revolute">
        <parent>post</parent>
        <child>arm</child>
        <pose>-0.5 0 0 0 0 0</pose>
        <axis>
          <xyz>0 1 0</xyz>
        </axis>
      </joint>
    </model>
