Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Marker
      Name: Marker
      Enabled: true
      Topic:
        Value: /markers
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Focal Point: {X: 0, Y: 0, Z: 0}
      Pitch: 0.7
      Yaw: 0.8
