Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 12
      Offset: {X: 5.5, Y: 5.5, Z: 0}
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 4
      Show Names: true
      Show Axes: true
      Show Arrows: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point: {X: 5.5, Y: 5.5, Z: 0}
      Pitch: 0.95
      Yaw: -1.57
Window Geometry:
  Width: 1920
  Height: 1080
